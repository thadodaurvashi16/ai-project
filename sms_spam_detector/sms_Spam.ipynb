   "source": [
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "messages=[\n",
    "    \"win a free prize\",\n",
    "    \"hello my friend\",\n",
    "    \"claim your free reward\"\n",
    "]\n",
    "vectorizer=TfidfVectorizer()\n",
    "X=vectorizer.fit_transform(messages)\n",
    "print(vectorizer.get_feature_names_out())\n",
    "print(X.toarray())"
   ]
